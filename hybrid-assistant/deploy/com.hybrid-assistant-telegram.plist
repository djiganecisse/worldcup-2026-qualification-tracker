<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Service launchd : pont Telegram de l'assistant hybride, relancé au boot
     du Mac Mini et en cas de crash. Lit les secrets dans
     ~/.hybrid-assistant.env (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
     et optionnellement HYBRID_AUTO=1, ANTHROPIC_API_KEY).
     __APP_DIR__ est remplacé par setup-macmini.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hybrid-assistant-telegram</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.hybrid-assistant.env"; set +a; cd __APP_DIR__ &amp;&amp; exec .venv/bin/python telegram_bridge.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/tmp/hybrid-assistant-telegram.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hybrid-assistant-telegram.log</string>
</dict>
</plist>
